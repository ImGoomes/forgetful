#!/usr/bin/env bash
set -euo pipefail

echo "Running pre-commit checks..."

# Check formatting
unformatted=$(gofmt -l .)
if [ -n "$unformatted" ]; then
  echo ""
  echo "  The following files are not formatted (run 'gofmt -w .'):"
  echo "$unformatted" | sed 's/^/    /'
  echo ""
  exit 1
fi

# Run vet
if ! go vet ./...; then
  echo ""
  echo "  'go vet' failed. Fix the issues above before committing."
  echo ""
  exit 1
fi

echo "All checks passed."
