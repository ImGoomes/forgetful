#!/usr/bin/env bash
set -euo pipefail

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Allow merge commits and revert commits
if echo "$commit_msg" | grep -qE "^(Merge|Revert) "; then
  exit 0
fi

# Conventional commits pattern: type(optional-scope)!?: description
pattern="^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([a-z0-9 _-]+\))?(!)?: .{1,}$"

if ! echo "$commit_msg" | grep -qE "$pattern"; then
  echo ""
  echo "  Invalid commit message format."
  echo ""
  echo "  Expected: <type>(<scope>): <description>"
  echo "  Example:  feat(cli): add version flag"
  echo ""
  echo "  Types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test"
  echo ""
  echo "  Your message: $commit_msg"
  echo ""
  exit 1
fi
